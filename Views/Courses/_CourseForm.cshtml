@model CourseFormViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="MaxStudents" class="form-label"></label>
        <input asp-for="MaxStudents" class="form-control" />
        <span asp-validation-for="MaxStudents" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="InstructorId" class="form-label"></label>
        <select asp-for="InstructorId" asp-items="Model.Instructors" class="form-select">
            <option value="">-- choose --</option>
        </select>
        <span asp-validation-for="InstructorId" class="text-danger"></span>
    </div>
</div>
<button type="submit" class="btn btn-primary">Save</button>
<a asp-action="Index" class="btn btn-secondary">Cancel</a>
