@model CourseDetailsViewModel
@{
    var course = Model.Course;
    ViewData["Title"] = course.Name;
}

<h2>@course.Name</h2>
<p class="text-muted">by @course.Instructor?.FullName</p>
<p>@course.Description</p>

<dl class="row">
    <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@course.Price.ToString("C")</dd>
    <dt class="col-sm-3">Seats</dt>
    <dd class="col-sm-9">
        @Model.EnrolledCount / @course.MaxStudents
        @if (Model.IsFull) { <span class="badge bg-danger">Full</span> }
    </dd>
    <dt class="col-sm-3">Average rating</dt>
    <dd class="col-sm-9">@(Model.AverageRating is double avg ? avg.ToString("0.0") + " / 5" : "No reviews yet")</dd>
</dl>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Enroll a student</h5>
        <form asp-controller="Enrollments" asp-action="Enroll" method="post" class="row g-2">
            <input type="hidden" name="courseId" value="@course.Id" />
            <div class="col-md-6">
                <select name="studentId" asp-items="Model.Students" class="form-select" required>
                    <option value="">-- choose student --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success">Enroll</button>
            </div>
        </form>
    </div>
</div>

<h4>Lessons</h4>
@if (course.Lessons.Count == 0)
{
    <p class="text-muted">No lessons yet.</p>
}
else
{
    <ol>
    @foreach (var lesson in course.Lessons.OrderBy(l => l.OrderIndex))
    {
        <li>@lesson.Title</li>
    }
    </ol>
}

<div class="d-flex justify-content-between align-items-center mt-4">
    <h4>Reviews</h4>
    <a asp-controller="Reviews" asp-action="Create" asp-route-courseId="@course.Id" class="btn btn-outline-primary btn-sm">Write a review</a>
</div>
@if (course.Reviews.Count == 0)
{
    <p class="text-muted">No reviews yet.</p>
}
else
{
    foreach (var review in course.Reviews.OrderByDescending(r => r.CreatedAt))
    {
        <div class="border rounded p-3 mb-2">
            <strong>@review.Student?.FullName</strong> - @review.Rating / 5
            @if (!string.IsNullOrWhiteSpace(review.Comment))
            {
                <p class="mb-0">@review.Comment</p>
            }
        </div>
    }
}

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
