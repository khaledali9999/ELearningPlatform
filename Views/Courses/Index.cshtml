@model IEnumerable<Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Courses</h2>
    <a asp-action="Create" class="btn btn-primary">Add course</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Name</th><th>Instructor</th><th>Price</th><th>Enrolled</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var course in Model)
    {
        <tr>
            <td>@course.Name</td>
            <td>@course.Instructor?.FullName</td>
            <td>@course.Price.ToString("C")</td>
            <td>@course.Enrollments.Count / @course.MaxStudents</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
