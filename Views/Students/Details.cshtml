@model Student
@{
    ViewData["Title"] = Model.FullName;
}

<h2>@Model.FullName</h2>
<dl class="row">
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Phone</dt><dd class="col-sm-10">@(Model.PhoneNumber ?? "-")</dd>
    <dt class="col-sm-2">Joined</dt><dd class="col-sm-10">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
</dl>

<h4>Enrolled courses</h4>
@if (Model.Enrollments.Count == 0)
{
    <p class="text-muted">Not enrolled in any course yet.</p>
}
else
{
    <ul class="list-group mb-3">
    @foreach (var enrollment in Model.Enrollments)
    {
        <li class="list-group-item">
            <a asp-controller="Courses" asp-action="Details" asp-route-id="@enrollment.CourseId">@enrollment.Course?.Name</a>
            <span class="text-muted">- @enrollment.EnrolledAt.ToString("yyyy-MM-dd")</span>
        </li>
    }
    </ul>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
