@model ReviewFormViewModel
@{
    ViewData["Title"] = "Write a review";
}

<h2>Review: @Model.CourseName</h2>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="CourseId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="StudentId" class="form-label"></label>
        <select asp-for="StudentId" asp-items="Model.Students" class="form-select">
            <option value="">-- choose student --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Rating" class="form-label"></label>
        <select asp-for="Rating" class="form-select">
            @for (var rating = 1; rating <= 5; rating++)
            {
                <option value="@rating">@rating</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Comment" class="form-label"></label>
        <textarea asp-for="Comment" class="form-control" rows="4"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Submit review</button>
    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-secondary">Cancel</a>
</form>
